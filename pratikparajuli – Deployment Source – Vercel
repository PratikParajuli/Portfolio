@keyframes successBlue { 
  0% { fill: var(--ds-gray-alpha-400); }
  100% { fill: var(--ds-blue-900); }
}

.error .dot { fill: var(--ds-gray-700); animation: auto ease 0s 1 normal none running none; filter: none; }
