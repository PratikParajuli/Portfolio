.dot { transition: fill 0.3s ease-in-out, filter 0.3s ease-in-out; }

.idle .dot { fill: var(--idle-color, var(--ds-gray-800)); animation-iteration-count: 1; filter: drop-shadow(transparent 0px 0px 0px); }

.fade .dot { fill: var(--ds-gray-alpha-500); }

.fade .dot-1 { animation: 0.9s ease-in-out 0s infinite normal none running fadeGray; }

.fade .dot-3 { animation: 0.9s ease-in-out 0.1s infinite normal none running fadeGray; }

.fade .dot-6 { animation: 0.9s ease-in-out 0.2s infinite normal none running fadeGray; }

.fade .dot-10 { animation: 0.9s ease-in-out 0.3s infinite normal none running fadeGray; }

.fade .dot-9 { animation: 0.9s ease-in-out 0.4s infinite normal none running fadeGray; }

