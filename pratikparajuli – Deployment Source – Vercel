.fade .dot-4 { animation: 0.9s ease-in-out 0.7s infinite normal none running fadeGray; }

.fade .dot-2 { animation: 0.9s ease-in-out 0.8s infinite normal none running fadeGray; }

.fade .dot-5 { fill: var(--ds-gray-200); animation: auto ease 0s 1 normal none running none; }

@keyframes fadeGray { 
  0%, 80%, 100% { fill: var(--ds-gray-alpha-600); }
  40% { fill: var(--ds-gray-alpha-900); }
}

.ripple .dot { fill: var(--ds-gray-alpha-500); animation: 2s ease-in-out 0s infinite normal none running rippleGray; }

.ripple .dot-5 { animation-delay: 0s; }

.ripple .dot-4, .ripple .dot-6 { animation-delay: 0.16s; }

.ripple .dot-2, .ripple .dot-3, .ripple .dot-8, .ripple .dot-9 { animation-delay: 0.3s; }

.ripple .dot-1, .ripple .dot-7, .ripple .dot-10 { animation-delay: 0.41s; animation-timing-function: cubic-bezier(0.58, 0, 0.38, 0.98); }

@keyframes rippleGray { 
  0%, 60%, 100% { fill: var(--ds-gray-alpha-400); filter: drop-shadow(transparent 0px 0px 0px); }
  30% { fill: var(--ds-gray-alpha-1000); filter: drop-shadow(rgba(23, 23, 23, 0.2) 0px 0px 1.5px); }
}

.success .dot { fill: var(--ds-blue-900); filter: none; animation: 0.3s ease-in-out 0s 1 normal forwards running successBlue; }

